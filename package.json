{
  "name": "@aryzing/bun-mock-fetch",
  "version": "1.2.0",
  "author": "Eduard Bardají Puig <@aryzing>",
  "description": "Mock fetch requests in Bun.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryzing/bun-mock-fetch.git"
  },
  "scripts": {
    "build": "tsc",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm --quiet",
    "ci": "bun run check-format && bun test && bun run build && bun run check-exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0 || ^7.0.2"
  },
  "license": "MIT",
  "dependencies": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.2"
  },
  "keywords": [
    "bun",
    "fetch",
    "mock",
    "mocking",
    "test",
    "testing",
    "tests"
  ]
}
