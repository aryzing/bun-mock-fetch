{
  "name": "@aryzing/bun-mock-fetch",
  "version": "1.0.4",
  "author": "Eduard Bardají Puig <@aryzing>",
  "description": "Mock fetch requests in Bun.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aryzing/bun-mock-fetch.git"
  },
  "scripts": {
    "build": "tsc",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm --quiet",
    "ci": "bun run check-format && bun test && bun run build && bun run check-exports"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.4",
    "@types/bun": "latest",
    "prettier": "^3.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "glob": "^11.0.2",
    "minimatch": "^10.0.1"
  },
  "keywords": [
    "bun",
    "mock",
    "fetch",
    "mocking",
    "testing"
  ]
}
